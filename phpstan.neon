parameters:
    level: 8
    paths:
        - src/
        - tests/

    excludePaths:
        - src/Kernel.php
        - src/Entity/
        - src/Repository/

    tmpDir: var/cache/phpstan

    editorUrl: 'phpstorm://open?file=%%file%%&line=%%line%%'

    treatPhpDocTypesAsCertain: false

    symfony:
        containerXmlPath: var/cache/dev/App_KernelDevDebugContainer.xml

    ignoreErrors:
        # Doctrine Repository::findOneBy() no es genérico — devuelve object|null
        # con treatPhpDocTypesAsCertain:false, PHPStan usa el tipo nativo object,
        # no el PHPDoc de la entidad. Estos patterns cubren llamadas específicas
        # a entidades devueltas por repositorios.
        - '#Call to an undefined method object::(getSettings|getGithubRepos|setEncryptedToken|getEncryptedToken|setGithubUsername|getId|getGithubUsername)\(\)#'
        - '#Parameter \#\d \$account of method App\\Repository\\GithubRepoRepository::findRepoIdsByAccount\(\) expects App\\Entity\\GithubAccount, object given\.#'
        - '#Parameter \#\d \$account of method App\\Service\\Analysis\\CvImprovementAnalyzer::buildContext\(\) expects App\\Entity\\GithubAccount, object given\.#'
        - '#Parameter \#\d \$user of method App\\Service\\Analysis\\CvImprovementAnalyzer::analyze\(\) expects App\\Entity\\User, object given\.#'
        - '#Parameter \#\d \$user of method App\\Service\\Analysis\\CommitAnalyzer::analyze\(\) expects App\\Entity\\User, object given\.#'
        - '#Method App\\Controller\\SettingsController::getOrCreateUser\(\) should return App\\Entity\\User but returns object\.#'

        # GitHub client library typing issues (conocidas upstream)
        - '#Call to an undefined method Github\\Api\\AbstractApi::getRateLimits\(\)\.#'
        - '#Parameter \#\d \$visibility of method Github\\Api\\.*::repositories\(\) expects string\|null, int<1, max> given\.#'

        # Tests: aserciones siempre true por PHPDoc types (Foundry proxies, DIC)
        - '#Call to (static method|function) [^(]+::assert(InstanceOf|True|False)\(\) with [^)]+ will always evaluate to (true|false)\.#'
        - '#Instanceof between [^ ]+ will always evaluate to true\.#'
        - '#Call to (static )?method [^(]+::assertNotNull\(\) with [^)]+ will always evaluate to true\.#'

        # Tests: @var tag con tipo nullable vs tipo nativo no-nullable
        - '#PHPDoc tag @var with type string\|null is not subtype of native type string\.#'

        # Doctrine: QueryBuilder::orderBy() es call mágico via __call()
        - '#Call to an undefined method Doctrine\\ORM\\QueryBuilder::orderBy\(\)\.#'

    reportUnmatchedIgnoredErrors: false

includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
