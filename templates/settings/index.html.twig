{% extends 'base.html.twig' %}

{% block title %}Settings &mdash; GitHub CV Analyzer{% endblock %}

{% block body %}
<div class="mb-8">
    <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Settings</h1>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        Configure your GitHub connection to start analyzing contributions.
    </p>
</div>

<div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
    <div class="rounded-lg bg-white dark:bg-gray-900 shadow p-6">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">GitHub Connection</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
            Paste a personal access token with <code class="text-xs bg-gray-100 dark:bg-gray-800 px-1 rounded">repo</code> and <code class="text-xs bg-gray-100 dark:bg-gray-800 px-1 rounded">read:user</code> scopes.
            <a href="https://github.com/settings/tokens/new?scopes=repo,read:user&description=GitHub+CVAnalyzer"
               target="_blank" rel="noopener"
               class="text-blue-500 hover:text-blue-600 underline">
                Create one here &rarr;
            </a>
        </p>

        {% if verification %}
            {% if verification.success %}
                <div class="mt-4 rounded-md bg-green-50 dark:bg-green-900/20 p-4">
                    <p class="text-sm text-green-800 dark:text-green-300">
                        Token verified for <strong>{{ verification.username }}</strong>
                    </p>
                </div>
            {% else %}
                <div class="mt-4 rounded-md bg-red-50 dark:bg-red-900/20 p-4">
                    <p class="text-sm text-red-800 dark:text-red-300">
                        Verification failed: {{ verification.error }}
                    </p>
                </div>
            {% endif %}
        {% endif %}

        <form method="post" action="{{ path('app_settings') }}" class="mt-6 space-y-4">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">

            <div>
                <label for="github_token" class="block text-sm font-medium text-gray-700 dark:text-gray-300">
                    GitHub Personal Access Token
                </label>
                <div class="mt-1">
                    <input
                        type="password"
                        name="github_token"
                        id="github_token"
                        placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
                        class="block w-full rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-2 text-sm text-gray-900 dark:text-white shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                    >
                </div>
            </div>

            <div class="flex space-x-3">
                <button
                    type="submit"
                    class="inline-flex items-center rounded-md bg-gray-800 dark:bg-white px-4 py-2 text-sm font-semibold text-white dark:text-gray-900 shadow-sm hover:bg-gray-700 dark:hover:bg-gray-100"
                >
                    Save &amp; Sync Repositories
                </button>

                <button
                    type="button"
                    form="verify-form"
                    class="inline-flex items-center rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-2 text-sm font-semibold text-gray-700 dark:text-gray-300 shadow-sm hover:bg-gray-50 dark:hover:bg-gray-700"
                >
                    Verify Token
                </button>
            </div>
        </form>

        <form id="verify-form" method="post" action="{{ path('app_settings_verify') }}" class="hidden">
            <input type="hidden" name="_token" value="{{ csrf_token('verify') }}">
            <input type="hidden" name="github_token" id="verify_token">
        </form>
    </div>

    <div class="rounded-lg bg-white dark:bg-gray-900 shadow p-6">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white">Account Status</h2>

        {% if account and account.lastSyncedAt %}
            <div class="mt-4 rounded-md bg-green-50 dark:bg-green-900/20 p-4">
                <dl class="space-y-2">
                    <div class="flex justify-between">
                        <dt class="text-sm text-gray-500 dark:text-gray-400">Username</dt>
                        <dd class="text-sm font-medium text-gray-900 dark:text-white">{{ account.githubUsername }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-sm text-gray-500 dark:text-gray-400">Connected repositories</dt>
                        <dd class="text-sm font-medium text-gray-900 dark:text-white">{{ account.githubRepos|length }}</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-sm text-gray-500 dark:text-gray-400">Last sync</dt>
                        <dd class="text-sm font-medium text-gray-900 dark:text-white">{{ account.lastSyncedAt|date('Y-m-d H:i') }}</dd>
                    </div>
                </dl>
            </div>
        {% else %}
            <div class="mt-4 rounded-md bg-amber-50 dark:bg-amber-900/20 p-4">
                <p class="text-sm text-amber-800 dark:text-amber-300">
                    No GitHub account connected yet. Add your token to get started.
                </p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.querySelector('button[form="verify-form"]').addEventListener('click', () => {
            document.getElementById('verify_token').value = document.getElementById('github_token').value;
            document.getElementById('verify-form').submit();
        });
    </script>
{% endblock %}
