{% extends 'base.html.twig' %}

{% block title %}{{ repo.name }} &mdash; GitHub CV Analyzer{% endblock %}

{% block body %}
<div class="mb-6">
    <a href="{{ path('app_dashboard') }}" class="text-sm text-blue-500 hover:text-blue-600">&larr; Back to Dashboard</a>
</div>

<div class="rounded-lg bg-white dark:bg-gray-900 shadow p-6 mb-6">
    <div class="flex items-start justify-between">
        <div>
            <h1 class="text-xl font-bold text-gray-900 dark:text-white">{{ repo.name }}</h1>
            <p class="text-sm text-gray-500 dark:text-gray-400">{{ repo.fullName }}</p>
            {% if repo.description %}
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">{{ repo.description }}</p>
            {% endif %}
        </div>
        {% if repo.language %}
            <span class="text-xs font-medium bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 px-2 py-1 rounded-full">{{ repo.language }}</span>
        {% endif %}
    </div>

    <div class="mt-4 flex flex-wrap gap-3 text-sm">
        <span class="text-gray-500 dark:text-gray-400">&#x2605; {{ repo.stars }} stars</span>
        <span class="text-gray-500 dark:text-gray-400">&#x2442; {{ repo.forks }} forks</span>
        {% if repo.metadata.topics is defined %}
            {% for topic in repo.metadata.topics %}
                <span class="text-xs bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 px-2 py-0.5 rounded-full">{{ topic }}</span>
            {% endfor %}
        {% endif %}
    </div>
</div>

{% if techCounts|length > 0 or classificationCounts|length > 0 %}
<div class="grid grid-cols-1 gap-6 lg:grid-cols-2 mb-6">
    {% if classificationCounts|length > 0 %}
    <div class="rounded-lg bg-white dark:bg-gray-900 shadow p-6">
        <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-4">Classification</h3>
        <div class="space-y-2">
            {% for type, count in classificationCounts %}
                <div class="flex items-center justify-between">
                    <span class="text-sm text-gray-700 dark:text-gray-300 capitalize">{{ type }}</span>
                    <div class="flex items-center space-x-2">
                        <div class="w-32 h-2 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                            <div class="h-full bg-blue-500 rounded-full" style="width: {{ (count / classificationCounts|reduce((c, v) => c + v, 0)) * 100 }}%"></div>
                        </div>
                        <span class="text-xs text-gray-500 dark:text-gray-400 w-6 text-right">{{ count }}</span>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    {% if techCounts|length > 0 %}
    <div class="rounded-lg bg-white dark:bg-gray-900 shadow p-6">
        <h3 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-4">Technologies</h3>
        <div class="flex flex-wrap gap-2">
            {% for tech, count in techCounts %}
                <span class="inline-flex items-center text-xs bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 px-2 py-1 rounded-full">
                    {{ tech }}
                    <span class="ml-1 text-gray-400">({{ count }})</span>
                </span>
            {% endfor %}
        </div>
    </div>
    {% endif %}
</div>
{% endif %}

<div class="rounded-lg bg-white dark:bg-gray-900 shadow p-6">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">
        Recent Commits
        <span class="text-sm font-normal text-gray-500 dark:text-gray-400">({{ commits|length }})</span>
    </h2>

    {% if commits|length > 0 %}
        <div class="space-y-3">
            {% for commit in commits %}
                <div class="border-b border-gray-100 dark:border-gray-800 pb-3 last:border-0 last:pb-0">
                    <div class="flex items-start justify-between">
                        <div class="flex-1 min-w-0">
                            <p class="text-sm text-gray-900 dark:text-white truncate">
                                {{ commit.message|split('\n')|first|slice(0, 100) }}
                            </p>
                            <div class="mt-1 flex items-center space-x-3 text-xs text-gray-500 dark:text-gray-400">
                                <span>{{ commit.date|date('Y-m-d') }}</span>
                                <span>+{{ commit.additions }}/-{{ commit.deletions }}</span>
                                <span class="font-mono text-gray-400">{{ commit.sha|slice(0, 7) }}</span>
                            </div>
                        </div>
                        {% if commit.analysisResult %}
                            {% set clf = commit.analysisResult.classification %}
                            <span class="flex-shrink-0 text-xs px-2 py-0.5 rounded-full font-medium
                                {% if clf.classification == 'feature' %}bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300
                                {% elseif clf.classification == 'bugfix' %}bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-300
                                {% elseif clf.classification == 'refactor' %}bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-300
                                {% elseif clf.classification == 'docs' %}bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300
                                {% elseif clf.classification == 'test' %}bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-300
                                {% else %}bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300{% endif %}">
                                {{ clf.classification|default('?') }}
                                {% if clf.complexity_score is defined %}&middot; {{ clf.complexity_score }}/10{% endif %}
                            </span>
                        {% else %}
                            <span class="flex-shrink-0 text-xs text-gray-400">pending</span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p class="text-sm text-gray-500 dark:text-gray-400">No commits synced yet.</p>
    {% endif %}
</div>
{% endblock %}
